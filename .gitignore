# Local hidden folders generated by running 'terraform init'
# Contains downloaded provider plugins (e.g., AWS plugins) and third-party modules
**/.terraform/

# Local state tracking files. These store your actual cloud infrastructure data and secrets.
# They should live securely in an S3 bucket backend, NEVER on GitHub.
*.tfstate
*.tfstate.*

# Crash log files generated if Terraform encounters a critical runtime error
crash.log
crash.*

# Local override files used for quick testing (e.g., override.tf, override.tf.json)
*.override.tf
*.override.tf.json
*._override.tf

# Specific local environment files that typically contain sensitive API keys/secrets
.terraformrc
terraform.rc

# Ignore automatically generated configuration files from migration runs
# (Unless you intend to explicitly commit them later)
**/generated_resources.tf

# EXCEPTION: If you create secret variable files locally to test deployments,
# ensure they are blocked by pattern matching.
*.secret.tfvars
secrets.tfvars
